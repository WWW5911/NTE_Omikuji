@using NteOmikuji.Core.Analysis

<div class="page analysis" id="analysis">
    <div class="toolbar">
        <div class="luck-headline">
            <h2 class="page-title" id="pool-title">@Title</h2>
            @if (_data.TotalPulls > 0)
            {
                <LuckTag Score="_data.Luck" Id="luck-pool" Fallback="無法判定"
                         FallbackReason="紀錄不完整或有活動未設定，暫時無法判定" />
                @if (_data.Luck is { } luck)
                {
                    <span class="luck-detail" id="luck-pool-detail">@LuckTag.Describe(luck)</span>
                }
            }
        </div>
        <div class="actions">
            <span class="hint">範圍 @_data.FirstDate 至 @_data.LastDate</span>
            @if (OnShare.HasDelegate && _data.TotalPulls > 0)
            {
                <button id="share-this" @onclick="() => OnShare.InvokeAsync()">分享</button>
            }
        </div>
    </div>
    @if (_data.TotalPulls == 0)
    {
        <p class="no-match">這個卡池還沒有抽取紀錄。</p>
    }
    else
    {
        @if (_data.HasExcessPointsRewards)
        {
            <div class="alert" id="old-decoding" role="status">這份紀錄的集點贈禮比遊戲實際給的多，可能有抽數被舊版誤判，以下的抽數與間隔會不準。重新擷取一次歷史紀錄即可更正。</div>
        }
        @if (BannerId is not null && _data.CarriedPulls > 0)
        {
            <p class="hint" id="carried-note">這期開始時已墊 @_data.CarriedPulls 抽（距上次@(LimitedAt is null ? " S" : "限定")），運氣的期望已把這些算進去。</p>
        }
        @if (BannerId is not null)
        {
            <p class="hint" id="ended-note">這期結束時已墊 @_data.EndedPulls 抽（距上次@(LimitedAt is null ? " S" : "限定")）。</p>
        }
        @if (_events.Count > 0)
        {
            <section class="chart" id="event-luck">
                <h3>各期運氣</h3>
                <div class="table-scroll">
                    <table class="summary">
                        <thead>
                            <tr>
                                <th>活動</th>
                                <th class="num">抽數</th>
                                <th class="num">開始已墊</th>
                                <th class="num">結束已墊</th>
                                <th class="num">@(LimitedAt is null ? "S" : "限定")</th>
                                <th class="num">期望</th>
                                <th class="num">σ</th>
                                <th>運氣</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (group, data) in _events)
                            {
                                <tr data-event="@group.Id">
                                    <th scope="row"><button class="link-inline" @onclick="() => OnOpenBanner.InvokeAsync(group.Id)">@group.Name</button></th>
                                    <td class="num">@group.Pulls.ToString("N0")</td>
                                    <td class="num">@data.CarriedPulls</td>
                                    <td class="num">@data.EndedPulls</td>
                                    <td class="num">@(LimitedAt is null ? data.TopRankCount : data.LimitedCount)</td>
                                    <td class="num">@(data.Luck is { } score ? $"{score.Expected:0.0} ± {score.StandardDeviation:0.0}" : "—")</td>
                                    <td class="num">@(data.Luck?.Sigma.ToString("+0.00;-0.00;0.00") ?? "—")</td>
                                    <td><LuckTag Score="data.Luck" Fallback="無法判定" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="hint">已墊是距上次@(LimitedAt is null ? " S" : "限定")的抽數。保底會跨期延續，所以每期的期望都從開始已墊的抽數算起。各期不能相加成整體運氣，整體請看頁面上方的標籤。</p>
            </section>
        }
        @if (BannerId is null && History.Banner.Kind != HistoryKind.Permanent && History.Rows.All(row => row.BannerId is null))
        {
            <p class="hint" id="no-banners">這份紀錄沒有活動資訊，所以無法分期查看。重新擷取一次就會在左側列出各期。</p>
        }
        <div class="tiles">
            @if (BannerId is null)
            {
                <div class="tile hero">
                    <span>距上次 S</span>
                    <strong id="since-top">@_data.PullsSinceTopRank</strong>
                    <small>@(_data.TopRankPity is { } pity ? $"/ {pity.Threshold} 抽" : "抽")</small>
                </div>
            }
            <div class="tile"><span>總抽數</span><strong id="total-pulls">@_data.TotalPulls.ToString("N0")</strong></div>
            <div class="tile"><span>S 數量</span><strong id="top-count">@_data.TopRankCount</strong></div>
            <div class="tile"><span>S 比例</span><strong>@Percent(_data.TopRankRate)</strong></div>
            <div class="tile"><span>S 平均間隔</span><strong id="average">@(_data.AverageInterval?.ToString("0.0") ?? "—")</strong></div>
            <div class="tile"><span>S 間隔中位數</span><strong id="median">@(_data.MedianInterval?.ToString("0.#") ?? "—")</strong></div>
            @if (_data.TopRanksBeforeRise is { } early && RisesFrom is { } rise)
            {
                <div class="tile"><span>@rise 抽前出 S</span><strong id="before-rise">@early 次</strong></div>
            }
            <div class="tile"><span>最短 / 最長</span><strong>@(_data.ShortestInterval?.ToString() ?? "—") / @(_data.LongestInterval?.ToString() ?? "—")</strong></div>
            @if (_data.LimitedCount > 0 && LimitedAt is null)
            {
                <div class="tile"><span>S 限定數量</span><strong id="limited-count">@_data.LimitedCount</strong></div>
            }
        </div>
        @if (LimitedAt is { } guaranteeAt && _data.TopRankCount > 0)
        {
            <div class="tiles" id="limited-stats">
                <div class="tile"><span>S 限定數量</span><strong id="limited-count">@_data.LimitedCount</strong></div>
                @if (BannerId is null && _data.PullsSinceLimited is { } sinceLimited)
                {
                    <div class="tile"><span>距上次限定</span><strong id="since-limited">@sinceLimited</strong></div>
                }
                <div class="tile"><span>非限定 S</span><strong id="off-banner">@(_data.TopRankCount - _data.LimitedCount)</strong></div>
                <div class="tile"><span>@guaranteeAt 抽保底觸發</span><strong id="guaranteed">@_data.GuaranteedLimitedCount 次</strong></div>
                <div class="tile">
                    <span>限定比例（不含保底）</span>
                    <strong id="observed-rate">@Percent(_data.ObservedLimitedRate)</strong>
                    <small>規則 @(History.Banner.Pity!.LimitedChance?.ToString("0%"))</small>
                </div>
            </div>
        }
        <p class="hint">
            S 指設定裡歸類為 S 角色、S 弧盤及其限定的項目；服裝、車皮與降落傘只統計，不影響間隔。
            @(BannerId is null ? "" : "這裡的總抽數只算這一期，每次 S 花的抽數則包含從前幾期累積過來的。")
            最舊一筆 S 之前的紀錄可能超出遊戲保留範圍，因此標為「至少」且不計入平均。
        </p>

        <div class="chart-grid">
            <section class="chart wide">
                <h3>每次 S 花了幾抽</h3>
                @if (RisesFrom is { } line)
                {
                    <p class="hint" id="rise-legend">虛線是第 @line 抽，從這裡起出 S 的機率上升。</p>
                }
                @if (_data.TopRankPulls.Count == 0)
                {
                    <p class="no-match">尚未抽到 S。</p>
                }
                else
                {
                    <ol class="interval-list" id="intervals" style="@RiseStyle">
                        @foreach (var pull in _data.TopRankPulls)
                        {
                            <li>
                                <span class="interval-name" title="@pull.RewardId">@pull.Name</span>
                                <span class="interval-tag">@pull.FocusLabel@(pull.Source is { } source ? $"・{source}" : "")</span>
                                <span class="interval-track">
                                    <span class="@(pull.IsLimited ? "interval-bar limited" : "interval-bar")" style="width:@Width(pull.PullsSpent, _maxInterval)"></span>
                                    <span class="interval-value">@(pull.IsLowerBound ? "至少 " : "")@pull.PullsSpent</span>
                                </span>
                                <span class="interval-date">@pull.Timestamp[..Math.Min(10, pull.Timestamp.Length)]</span>
                            </li>
                        }
                    </ol>
                }
            </section>

            @if (LimitedAt is { } limitAt && LimitedPulls.Count > 0)
            {
                <section class="chart wide" id="limited-section">
                    <h3>每次限定花了幾抽</h3>
                    <p class="hint">長條的滿格是 @limitAt 抽。計數跨活動累積，抽到其他 S 不會歸零。</p>
                    <ol class="interval-list" id="limited-intervals">
                        @foreach (var pull in LimitedPulls)
                        {
                            <li>
                                <span class="interval-name" title="@pull.RewardId">@pull.Name</span>
                                <span class="interval-tag">@(pull.IsGuaranteed ? $"{limitAt} 抽保底" : "機率抽中")</span>
                                <span class="interval-track">
                                    <span class="interval-bar limited" style="width:@Width(pull.LimitedSpent ?? 0, limitAt)"></span>
                                    <span class="interval-value">@(pull.IsLimitedLowerBound ? "至少 " : "")@pull.LimitedSpent</span>
                                </span>
                                <span class="interval-date">@pull.Timestamp[..Math.Min(10, pull.Timestamp.Length)]</span>
                            </li>
                        }
                    </ol>
                </section>
            }

            @if (_data.IntervalHistogram is { Count: > 0 } histogram && histogram.Any(bucket => bucket.Count > 0))
            {
                <section class="chart" id="interval-histogram">
                    <h3>S 間隔分布</h3>
                    <ColumnChart Buckets="histogram" Unit="次" />
                </section>
            }

            <FocusBreakdown Data="_data" />

            <section class="chart">
                <h3>稀有度組成（含道具）</h3>
                <div class="stack" role="img" aria-label="@RarityText">
                    @foreach (var (bucket, index) in _data.RarityMix.Where(bucket => bucket.Count > 0).Select((bucket, index) => (bucket, index)))
                    {
                        <span class="@($"stack-part tier-{TierClass(bucket.Label)}")" style="flex-grow:@bucket.Count" title="@bucket.Label：@bucket.Count 抽"></span>
                    }
                </div>
                <ul class="legend">
                    @foreach (var bucket in _data.RarityMix)
                    {
                        <li><i class="@($"swatch tier-{TierClass(bucket.Label)}")"></i>@bucket.Label <b>@bucket.Count</b> <small>@Percent((double)bucket.Count / _data.TotalPulls)</small></li>
                    }
                </ul>
            </section>

            @if (_data.DiceRolls.Count > 0)
            {
                <section class="chart">
                    <h3>骰子點數分布</h3>
                    <ColumnChart Buckets="_data.DiceRolls" Unit="次" />
                </section>
            }

            <section class="chart @(_data.DiceRolls.Count == 0 ? "" : "wide")">
                <h3>每@(_data.TimeUnit)抽數</h3>
                <ColumnChart Buckets="_data.PullsOverTime" Unit="抽" />
            </section>

            <section class="chart">
                <h3>最常獲得</h3>
                <ol class="rank-list">
                    @foreach (var bucket in _data.TopRewards)
                    {
                        <li>
                            <span class="interval-name">@bucket.Label</span>
                            <span class="interval-track">
                                <span class="interval-bar" style="width:@Width(bucket.Count, _data.TopRewards[0].Count)"></span>
                                <span class="interval-value">@bucket.Count</span>
                            </span>
                        </li>
                    }
                </ol>
            </section>

            @if (_data.ResultKinds.Count > 0)
            {
                <section class="chart">
                    <h3>結果類型</h3>
                    <table class="mini">
                        <tbody>
                            @foreach (var bucket in _data.ResultKinds)
                            {
                                <tr><td>@bucket.Label</td><td class="num">@bucket.Count.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                </section>
            }
        </div>
    }
</div>

@code {
    private BannerAnalysis _data = null!;
    private int _maxInterval = 1;

    [Parameter, EditorRequired]
    public BannerHistory History { get; set; } = null!;

    [Parameter]
    public Func<HistoryRow, string>? NameOf { get; set; }

    [Parameter]
    public string? BannerId { get; set; }

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public EventCallback OnShare { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenBanner { get; set; }

    [Parameter]
    public Func<string, string?>? BannerName { get; set; }

    private List<(BannerGroup Group, BannerAnalysis Data)> _events = [];

    [Parameter]
    public IReadOnlyList<string> UnsetBanners { get; set; } = [];

    private int? RisesFrom => History.Banner.Pity?.RisesFrom;

    private int? LimitedAt => History.Banner.Pity?.LimitedAt;

    private List<TopRankPull> LimitedPulls => _data.TopRankPulls.Where(pull => pull.IsLimited).ToList();

    private string? RiseStyle => RisesFrom is { } rise
        ? $"--rise:{(100.0 * rise / _maxInterval).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%"
        : null;

    private string RarityText => string.Join("、", _data.RarityMix.Select(bucket => $"{bucket.Label} {bucket.Count} 抽"));

    protected override void OnParametersSet()
    {
        _data = HistoryAnalyzer.Analyze(History, NameOf, BannerId, UnsetBanners);
        // The standard board has one lasting event, which would only repeat the page's own figures.
        _events = BannerId is null && History.Banner.Kind != HistoryKind.Permanent
            ? HistoryAnalyzer.Banners(History, NameOf, BannerName).Select(group => (group, HistoryAnalyzer.Analyze(History, NameOf, group.Id, UnsetBanners))).ToList()
            : [];
        // Bars share the guaranteed count as their scale, so a long bar reads as close to pity.
        _maxInterval = Math.Max(History.Banner.Pity?.TopRankAt ?? 1, _data.TopRankPulls.Select(pull => pull.PullsSpent).DefaultIfEmpty(1).Max());
    }

    private static string Percent(double? value) => value is null ? "—" : value.Value.ToString("0.0%");

    private static string Width(int value, int max) =>
        $"{Math.Max(1.5, 100.0 * value / Math.Max(1, max)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string TierClass(string label) => label switch
    {
        HistoryAnalyzer.TopRankTargets => "s",
        HistoryAnalyzer.TopRankOthers => "s2",
        "A" => "a",
        "B" => "b",
        _ => "none",
    };
}
