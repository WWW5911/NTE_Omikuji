@page "/"
@using NteOmikuji.Core.Analysis
@implements IDisposable
@inject ExporterState State

<div class="app">
    <header class="topbar">
        <h1 class="brand">NTE Omikuji</h1>
        <nav class="topnav" aria-label="功能">
            <button id="nav-capture" class="@TopClass(Page.Capture, "capture-entry")" aria-current="@Current(_page == Page.Capture)" @onclick="() => Show(Page.Capture)">@(IsCapturing ? "擷取中" : "開始擷取")</button>
            <button id="nav-help" class="@TopClass(Page.Help)" aria-current="@Current(_page == Page.Help)" @onclick="() => Show(Page.Help)">擷取說明</button>
            <button id="nav-records" class="@TopClass(Page.Records)" aria-current="@Current(_page == Page.Records)" @onclick="() => Show(Page.Records)">原始紀錄</button>
            <button id="nav-account" class="@TopClass(Page.Account)" aria-current="@Current(_page == Page.Account)" @onclick="() => Show(Page.Account)">帳號</button>
        </nav>
        <div class="topbar-status">
            <span class="saved" id="saved">@(State.LastSaved is { } saved ? $"已自動儲存 {saved:HH:mm:ss}" : "自動儲存")</span>
            <span class="@(IsCapturing ? "status-chip live" : "status-chip")" id="status">@StatusText</span>
        </div>
    </header>

    <aside class="sidenav">
        <nav aria-label="卡池">
            <button id="nav-overview" class="@SideClass(_page == Page.Overview)" aria-current="@Current(_page == Page.Overview)" @onclick="() => Show(Page.Overview)">總覽</button>
            <PoolNavItem Kind="HistoryKind.LimitedCharacter" Label="限定棋盤" Count="PullsOf(HistoryKind.LimitedCharacter)" Banners="BannersOf(HistoryKind.LimitedCharacter)"
                         Active="IsActive(HistoryKind.LimitedCharacter)" ActiveBanner="@_banner" Expanded="_expanded.Contains(HistoryKind.LimitedCharacter)"
                         OnOpen="banner => OpenPool(HistoryKind.LimitedCharacter, banner)" OnToggle="() => Toggle(HistoryKind.LimitedCharacter)" />
            <PoolNavItem Kind="HistoryKind.Permanent" Label="常駐棋盤" Count="PullsOf(HistoryKind.Permanent)" Banners="[]"
                         Active="IsActive(HistoryKind.Permanent)" OnOpen="banner => OpenPool(HistoryKind.Permanent, banner)" />
            <PoolNavItem Kind="HistoryKind.ArcMiracleBox" Label="弧盤研募" Count="PullsOf(HistoryKind.ArcMiracleBox)" Banners="BannersOf(HistoryKind.ArcMiracleBox)"
                         Active="IsActive(HistoryKind.ArcMiracleBox)" ActiveBanner="@_banner" Expanded="_expanded.Contains(HistoryKind.ArcMiracleBox)"
                         OnOpen="banner => OpenPool(HistoryKind.ArcMiracleBox, banner)" OnToggle="() => Toggle(HistoryKind.ArcMiracleBox)" />
            <hr class="side-divider" />
            <button id="nav-share" class="@SideClass(_page == Page.Share)" aria-current="@Current(_page == Page.Share)" @onclick="() => Show(Page.Share)">分享圖</button>
            <button id="nav-settings" class="@SideClass(_page == Page.Settings)" aria-current="@Current(_page == Page.Settings)" @onclick="() => OpenSettings(false)">
                <span>獎勵與卡池設定</span>
                @if (State.UnsetBanners.Count > 0)
                {
                    <small class="side-badge" id="unset-count" title="有活動還沒設定限定大獎">@State.UnsetBanners.Count</small>
                }
            </button>
        </nav>
    </aside>

    <main class="main">
        @if (State.Error is { } error)
        {
            <div class="alert error" role="alert">@error</div>
        }
        @if (State.Notice is { } notice)
        {
            <div class="alert">@notice</div>
        }
        @if (State.FallbackReason is { } fallback)
        {
            <div class="alert">Npcap 無法使用，已改用原始通訊端：@fallback</div>
        }

        @if (State.UnsetBanners.Count > 0 && _page != Page.Settings)
        {
            <div class="alert" id="unset-banners" role="status">
                @State.UnsetBanners.Count 期活動還沒設定限定大獎，這些活動的限定統計與保底可能不準。
                <button class="link-inline" @onclick="() => OpenSettings(true)">前往設定</button>
            </div>
        }

        @switch (_page)
        {
            case Page.Share:
                <ShareView />
                break;
            case Page.Settings:
                <SettingsView @key="_settingsVisit" StartOnBanners="_settingsOnBanners" />
                break;
            case Page.Overview:
                <OverviewView Histories="State.Histories" NameOf="State.DisplayName" Schedule="State.Schedule" Language="@State.DisplayLanguage" UnsetBanners="State.UnsetBanners" OnOpenPool="kind => OpenPool(kind, null)" OnStartCapture="() => Show(Page.Capture)" />
                break;
            case Page.Pool:
                @if (State.Histories.FirstOrDefault(history => history.Banner.Kind == _pool) is { } poolHistory)
                {
                    <AnalysisView History="poolHistory" NameOf="State.DisplayName" BannerId="@_banner" Title="@PoolTitle(poolHistory)" UnsetBanners="State.UnsetBanners" />
                }
                else
                {
                    <div class="panel empty">
                        <h2>這個卡池還沒有紀錄</h2>
                        <p>到遊戲裡開啟這個卡池的歷史紀錄，並從第 1 頁往下捲。</p>
                        <button class="primary" @onclick="() => Show(Page.Capture)">前往開始擷取</button>
                    </div>
                }
                break;
            case Page.Capture:
                <CaptureView Options="_capture" />
                break;
            case Page.Help:
                <HelpView OnStartCapture="() => Show(Page.Capture)" />
                break;
            case Page.Records:
                <RecordsView />
                break;
            case Page.Account:
                <AccountView />
                break;
        }
    </main>
</div>

@code {
    private enum Page
    {
        Overview,
        Pool,
        Capture,
        Help,
        Records,
        Account,
        Settings,
        Share,
    }

    private readonly CaptureOptions _capture = new();
    private readonly HashSet<HistoryKind> _expanded = [];
    private Page _page = Page.Overview;
    private HistoryKind _pool = HistoryKind.LimitedCharacter;
    private string? _banner;
    private bool _settingsOnBanners;
    private int _settingsVisit;

    private bool IsCapturing => State.Status is ExporterStatus.Capturing or ExporterStatus.Stopping;

    private string StatusText => State.Status switch
    {
        ExporterStatus.Capturing => "擷取中",
        ExporterStatus.Stopping => "停止中",
        ExporterStatus.Importing => "匯入中",
        _ => "待命",
    };

    private static string? Current(bool active) => active ? "page" : null;

    private string TopClass(Page page, string extra = "") => $"top-link {extra} {(_page == page ? "active" : "")}".Trim();

    private static string SideClass(bool active) => active ? "side-link active" : "side-link";

    private bool IsActive(HistoryKind kind) => _page == Page.Pool && _pool == kind;

    private int? PullsOf(HistoryKind kind) =>
        State.Histories.FirstOrDefault(history => history.Banner.Kind == kind) is { } history ? HistoryAnalyzer.Analyze(history, State.DisplayName).TotalPulls : null;

    private IReadOnlyList<BannerGroup> BannersOf(HistoryKind kind) =>
        State.Histories.FirstOrDefault(history => history.Banner.Kind == kind) is { } history ? HistoryAnalyzer.Banners(history, State.DisplayName, State.BannerName) : [];

    private string PoolTitle(BannerHistory history)
    {
        var pool = history.Banner.Kind switch
        {
            HistoryKind.LimitedCharacter => "限定棋盤",
            HistoryKind.Permanent => "常駐棋盤",
            HistoryKind.ArcMiracleBox => "弧盤研募",
            _ => history.Banner.Name,
        };
        return _banner is null ? pool : $"{pool}・{HistoryAnalyzer.Banners(history, State.DisplayName, State.BannerName).FirstOrDefault(group => group.Id == _banner)?.Name ?? _banner}";
    }

    private void Show(Page page)
    {
        _page = page;
        _banner = null;
    }

    private void OpenSettings(bool onBanners)
    {
        _settingsOnBanners = onBanners;
        _settingsVisit++;
        Show(Page.Settings);
    }

    private void OpenPool(HistoryKind kind, string? banner)
    {
        _page = Page.Pool;
        _pool = kind;
        _banner = banner;
        _expanded.Add(kind);
    }

    private void Toggle(HistoryKind kind)
    {
        if (!_expanded.Remove(kind))
        {
            _expanded.Add(kind);
        }
    }

    protected override void OnInitialized()
    {
        _capture.LocalIp = LocalAddresses.Preferred() ?? LocalAddresses.List().FirstOrDefault()?.Ip;
        State.Changed += OnStateChanged;
        if (Elevation.TakePendingCapture() is { } pending)
        {
            _capture.LocalIp = pending.LocalIp;
            _capture.Backend = pending.Backend;
            _capture.RecordPackets = pending.RecordPackets;
            _page = Page.Capture;
            State.Start(pending.LocalIp, pending.Backend, pending.RecordPackets);
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;
}
