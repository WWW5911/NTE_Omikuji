@using NteOmikuji.Core.Analysis

<div class="page" id="overview">
    @if (_pools.Any(pool => pool.Data?.HasExcessPointsRewards == true))
    {
        <div class="alert" id="old-decoding" role="status">有卡池的集點贈禮比遊戲實際給的多，可能有抽數被舊版誤判，下面的數字會不準。重新擷取一次歷史紀錄即可更正。</div>
    }

    @if (_overall is { } overall)
    {
        <section class="chart luck-summary" id="luck-overall">
            <div class="luck-headline">
                <h3>整體運氣</h3>
                <LuckTag Score="overall" Id="luck-tag-overall" />
                <span class="luck-detail" id="luck-overall-detail">@LuckTag.Describe(overall)</span>
            </div>
            <ol class="luck-scale" aria-label="運氣等級，由差到好">
                @foreach (var tier in Enum.GetValues<LuckTier>())
                {
                    <li class="@(tier == overall.Tier ? $"luck-step active {LuckTag.ToneOf(tier)}" : "luck-step")" aria-current="@(tier == overall.Tier ? "true" : null)">
                        <b>@LuckModel.LabelOf(tier)</b>
                        <small>@RangeOf(tier)</small>
                    </li>
                }
            </ol>
            <p class="hint">把同樣抽數所有可能的結果精確排名：拿到越多越好，一樣多時最後一個越早出越好。排名換算成標準差（σ）後，落在哪裡就是哪一級。限定和常駐棋盤看 S，弧盤看限定大獎；前 N% 歐是同樣抽數下所有可能結果的理論排序，不是跟其他玩家比較。機率取自公開資料，只代表運氣，不預測下一抽。</p>
        </section>
    }

    <h2 class="page-title">保底狀態</h2>
    <section class="pity-grid">
        @foreach (var pool in _pools)
        {
            var kind = pool.Pool.Kind;
            <article class="pity-card" data-pool="@kind">
                <header class="pity-card-head">
                    <button class="link-title" @onclick="() => OnOpenPool.InvokeAsync(kind)">@pool.Label</button>
                    @if (pool.Data is { } poolData)
                    {
                        <LuckTag Score="poolData.Luck" Id="@($"luck-{kind}")"
                                 Fallback="無法判定"
                                 FallbackReason="紀錄不完整或有活動未設定，暫時無法判定" />
                    }
                </header>
                @if (pool.Data?.TopRankPity is { } pity)
                {
                    <p class="pity-hero">
                        <strong id="pity-left-@kind">@pity.Remaining</strong>
                        <span>@(pity.Exceeded ? "已超過保底" : $"抽內必出 {pool.TopLabel}")</span>
                    </p>
                    <PityMeter Status="pity" Label="@($"距上次 {pool.TopLabel}")" Id="@($"pity-{kind}")" />
                    @if (pity.Exceeded)
                    {
                        <p class="pity-note warn">超過 @pity.Threshold 抽還沒有 S，紀錄可能缺頁，或有 S 的關注類別沒有設定。</p>
                    }
                    else if (pity.IsLowerBound)
                    {
                        <p class="pity-note">紀錄裡還沒有 S，更早的抽數不在紀錄內，實際可能更多。</p>
                    }
                    @if (!pity.Exceeded && pity.RisesFrom is { } rise)
                    {
                        <p class="pity-note" id="rise-@kind">
                            @if (pity.HasRisen)
                            {
                                <span class="pity-raised">機率已上升（第 @rise 抽起）</span>
                            }
                            else
                            {
                                <span>再 @pity.PullsUntilRise 抽機率開始上升（第 @rise 抽起）</span>
                            }
                        </p>
                    }
                    @if (pool.Data.LimitedPity is { } limited)
                    {
                        <PityMeter Status="limited" Label="距上次限定" Id="@($"pity-limited-{kind}")" />
                        <p class="pity-note">
                            @if (limited.IsLowerBound)
                            {
                                <span>紀錄裡還沒有限定弧盤，更早的抽數不在紀錄內。如果其實抽過，請到獎勵與卡池設定確認該期的限定大獎。</span>
                            }
                            else if (limited.Exceeded)
                            {
                                <span class="warn">超過 @limited.Threshold 抽還沒有限定，請到獎勵與卡池設定確認各期的限定大獎。</span>
                            }
                            else
                            {
                                <span>再 @limited.Remaining 抽內必出限定。</span>
                            }
                            <span>每個 S 弧盤有 @(pool.Pool.Pity!.LimitedChance!.Value.ToString("0%")) 是限定。</span>
                        </p>
                    }
                    @if (kind != HistoryKind.ArcMiracleBox && pool.Data.SecondRankPity is { } second)
                    {
                        <PityMeter Status="second" Label="距上次集點贈禮（A）" Id="@($"pity-a-{kind}")" />
                        @if (second.Exceeded)
                        {
                            <p class="pity-note warn" id="a-note-@kind">超過 @second.Threshold 抽還沒有 A，紀錄可能缺頁，或這些項目的稀有度沒有設定。</p>
                        }
                        else
                        {
                            <p class="pity-note" id="a-note-@kind">再 @second.Remaining 抽內必出 A：集點贈禮固定每 10 抽給一次</p>
                        }
                    }
                }
                else
                {
                    <p class="pity-hero empty-pool"><strong>—</strong><span>@pool.Pool.Pity!.TopRankAt 抽內必出 @pool.TopLabel</span></p>
                    <p class="pity-note">還沒有紀錄。<button class="link-inline" @onclick="() => OnStartCapture.InvokeAsync()">前往擷取</button></p>
                }
            </article>
        }
    </section>

    @if (_upcoming.Count > 0)
    {
        <section class="chart" id="schedule">
            <h3>卡池預告</h3>
            <div class="table-scroll">
                <table class="summary">
                    <thead>
                        <tr>
                            <th>狀態</th>
                            <th>類型</th>
                            <th>卡池</th>
                            <th>限定大獎</th>
                            <th>期間</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _upcoming)
                        {
                            <tr data-schedule="@entry.Id">
                                <td class="@(entry.PhaseOn(_today) == SchedulePhase.Active ? "schedule-active" : "")">@StatusText(entry)</td>
                                <td>@(entry.IsArc ? "弧盤" : "棋盤")@(entry.IsRerun ? "・復刻" : "")</td>
                                <th scope="row">@entry.Name(Language)</th>
                                <td>@entry.FeaturedName(Language)</td>
                                <td class="schedule-dates">@entry.Starts.ToString("M/d") – @entry.Ends.ToString("M/d")@(entry.IsEstimate ? "（預估）" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="hint">期間以國際服為準，正確時間請以遊戲內公告為準；可在 mappings 資料夾的 schedule.csv 修改。</p>
        </section>
    }

    <section class="chart">
        <h3>各卡池統計</h3>
        <div class="table-scroll">
            <table class="summary" id="pool-summary">
                <thead>
                    <tr>
                        <th>卡池</th>
                        <th class="num">總抽數</th>
                        <th class="num">S 數量</th>
                        <th class="num">其中限定</th>
                        <th class="num">S 比例</th>
                        <th class="num">平均間隔</th>
                        <th class="num">中位數</th>
                        <th class="num">最短 / 最長</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pool in _pools)
                    {
                        <tr data-pool="@pool.Pool.Kind">
                            <th scope="row">@pool.Label</th>
                            @if (pool.Data is { } data)
                            {
                                <td class="num">@data.TotalPulls.ToString("N0")</td>
                                <td class="num">@data.TopRankCount</td>
                                <td class="num">@(pool.Pool.Kind == HistoryKind.Permanent ? "—" : data.LimitedCount.ToString())</td>
                                <td class="num">@(data.TopRankRate?.ToString("0.0%") ?? "—")</td>
                                <td class="num">@(data.AverageInterval?.ToString("0.0") ?? "—")</td>
                                <td class="num">@(data.MedianInterval?.ToString("0.#") ?? "—")</td>
                                <td class="num">@(data.ShortestInterval?.ToString() ?? "—") / @(data.LongestInterval?.ToString() ?? "—")</td>
                            }
                            else
                            {
                                <td class="num" colspan="7">尚無紀錄</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="hint">間隔計算跨活動累積。最舊一筆 S 之前的抽數可能不在紀錄內，所以不計入平均。</p>
    </section>

    <section class="chart">
        <h3>最近的 S</h3>
        @if (_recent.Count == 0)
        {
            <p class="no-match">還沒有抽到 S。</p>
        }
        else
        {
            <ol class="recent-list" id="recent-top">
                @foreach (var (pull, label) in _recent)
                {
                    <li>
                        <span class="interval-date">@pull.Timestamp[..Math.Min(10, pull.Timestamp.Length)]</span>
                        <span class="interval-name" title="@pull.RewardId">@pull.Name</span>
                        <span class="interval-tag">@label・@pull.FocusLabel</span>
                        <span class="interval-value">@(pull.IsLowerBound ? "至少 " : "")@pull.PullsSpent 抽</span>
                    </li>
                }
            </ol>
        }
    </section>
</div>

@code {
    private const int RecentCount = 8;

    private sealed record PoolCard(PoolInfo Pool, string Label, string TopLabel, PoolAnalysis? Data);

    private List<PoolCard> _pools = [];
    private List<(TopRankPull Pull, string Label)> _recent = [];
    private IReadOnlyList<ScheduledEvent> _upcoming = [];
    private DateOnly _today;
    private LuckScore? _overall;

    [Parameter]
    public IReadOnlyList<string> UnsetEvents { get; set; } = [];

    private static string RangeOf(LuckTier tier) => tier switch
    {
        LuckTier.VeryUnlucky => "−2σ 以下",
        LuckTier.Unlucky => "−2 ～ −1σ",
        LuckTier.SlightlyUnlucky => "−1 ～ −0.5σ",
        LuckTier.SlightlyLucky => "+0.5 ～ +1σ",
        LuckTier.Lucky => "+1 ～ +2σ",
        LuckTier.VeryLucky => "+2σ 以上",
        _ => "±0.5σ 內",
    };

    [Parameter]
    public IReadOnlyList<ScheduledEvent> Schedule { get; set; } = [];

    [Parameter]
    public string Language { get; set; } = RewardSchema.Chinese;

    private string StatusText(ScheduledEvent entry) => entry.PhaseOn(_today) == SchedulePhase.Active
        ? $"進行中，剩 {entry.DaysLeft(_today)} 天"
        : $"{entry.DaysUntilStart(_today)} 天後開始";

    [Parameter, EditorRequired]
    public IReadOnlyList<PoolHistory> Histories { get; set; } = [];

    [Parameter]
    public Func<HistoryRow, string>? NameOf { get; set; }

    [Parameter]
    public EventCallback<HistoryKind> OnOpenPool { get; set; }

    [Parameter]
    public EventCallback OnStartCapture { get; set; }

    protected override void OnParametersSet()
    {
        _today = DateOnly.FromDateTime(DateTime.Now);
        _upcoming = EventSchedule.Visible(Schedule, _today);
        _pools =
        [
            Build(PoolInfo.LimitedCharacter, "限定棋盤", "S"),
            Build(PoolInfo.Permanent, "常駐棋盤", "S"),
            Build(PoolInfo.ArcMiracleBox, "弧盤研募", "S 弧盤"),
        ];
        _overall = LuckModel.Combine(_pools.Select(pool => pool.Data?.Luck));
        _recent = _pools.Where(pool => pool.Data is not null)
            .SelectMany(pool => pool.Data!.TopRankPulls.Select(pull => (Pull: UntilLimited(pool.Pool, pull), pool.Label)))
            .OrderByDescending(entry => entry.Pull.Timestamp, StringComparer.Ordinal)
            .Take(RecentCount)
            .ToList();
    }

    /// <summary>A limited Arc is what the pool is judged on, so its cost runs back to the last limited one, past ordinary S.</summary>
    private static TopRankPull UntilLimited(PoolInfo poolInfo, TopRankPull pull) =>
        poolInfo.Pity?.LimitedAt is not null && pull.IsLimited
            ? pull with { PullsSpent = pull.LimitedSpent ?? pull.PullsSpent, IsLowerBound = pull.IsLimitedLowerBound }
            : pull;

    private PoolCard Build(PoolInfo poolInfo, string label, string topLabel)
    {
        var history = Histories.FirstOrDefault(item => item.Pool.Kind == poolInfo.Kind);
        return new PoolCard(poolInfo, label, topLabel, history is null ? null : HistoryAnalyzer.Analyze(history, NameOf, unsetEvents: UnsetEvents));
    }
}
