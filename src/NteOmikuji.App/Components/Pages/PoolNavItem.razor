@using NteOmikuji.Core.Analysis

<div class="pool-nav">
    <div class="pool-nav-row">
        <button id="nav-pool-@Kind" class="@(Active && ActiveBanner is null ? "side-link active" : "side-link")" aria-current="@(Active && ActiveBanner is null ? "page" : null)" @onclick="() => OnOpen.InvokeAsync(null)">
            <span>@Label</span>
            @if (Count is { } count)
            {
                <small>@count.ToString("N0") 抽</small>
            }
        </button>
        @if (Banners.Count > 0)
        {
            <button class="pool-toggle" id="toggle-@Kind" aria-expanded="@(Expanded ? "true" : "false")" aria-label="@ToggleLabel" @onclick="OnToggle">@(Expanded ? "▾" : "▸")</button>
        }
    </div>
    @if (Expanded && Banners.Count > 0)
    {
        <ul class="banner-list" id="banners-@Kind">
            @foreach (var banner in Banners)
            {
                var id = banner.Id;
                <li>
                    <button class="@(Active && ActiveBanner == id ? "banner-link active" : "banner-link")" data-banner="@id" aria-current="@(Active && ActiveBanner == id ? "page" : null)" title="@id" @onclick="() => OnOpen.InvokeAsync(id)">
                        <span class="banner-name">@banner.Name</span>
                        <small>@DateOf(banner.LastDate)・@banner.Pulls 抽</small>
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public HistoryKind Kind { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public int? Count { get; set; }

    [Parameter]
    public IReadOnlyList<BannerGroup> Banners { get; set; } = [];

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public string? ActiveBanner { get; set; }

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EventCallback<string?> OnOpen { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }

    private string ToggleLabel => $"{(Expanded ? "收合" : "展開")}{Label}各期";

    private static string DateOf(string? date) => date is { Length: >= 10 } ? date[5..10] : "—";
}
