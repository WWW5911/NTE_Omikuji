@implements IDisposable
@inject AppState State

<div class="page records-page" id="settings">
    <div class="toolbar">
        <div>
            <h2 class="page-title">獎勵與卡池設定</h2>
            <p class="hint" id="mapping-status">已載入 @State.MappedRewardCount 筆獎勵@(UnmappedTotal > 0 ? $"，{UnmappedTotal} 筆未對應" : "")。遊戲更新後可以在這裡自行補上，不用等程式更新。</p>
        </div>
        <div class="actions">
            <div class="view-switch" role="tablist">
                <button id="open-editor" role="tab" aria-selected="@(!_showEvents)" class="@(_showEvents ? "" : "active")" @onclick="() => _showEvents = false">獎勵</button>
                <button id="settings-tab-events" role="tab" aria-selected="@_showEvents" class="@(_showEvents ? "active" : "")" @onclick="() => _showEvents = true">活動卡池@(State.UnsetEvents.Count > 0 ? $"（{State.UnsetEvents.Count}）" : "")</button>
            </div>
            <button id="reload-mappings" @onclick="State.ReloadMappings">重新載入</button>
        </div>
    </div>

    @if (State.MappingIssues.Count > 0)
    {
        <ul class="issues" id="mapping-issues">
            @foreach (var issue in State.MappingIssues.Take(5))
            {
                <li>@issue</li>
            }
        </ul>
    }

    @if (_showEvents)
    {
        <EventEditor />
    }
    else
    {
        <MappingEditor />
    }
</div>

@code {
    private bool _showEvents;

    [Parameter]
    public bool StartOnEvents { get; set; }

    private int UnmappedTotal => State.SeenRewards.Keys.Count(id => !State.Rewards.Entries.Any(entry => entry.Id.Equals(id, StringComparison.OrdinalIgnoreCase)));

    protected override void OnInitialized()
    {
        _showEvents = StartOnEvents;
        State.Changed += OnStateChanged;
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;
}
