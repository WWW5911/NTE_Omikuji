<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NteOmikuji.App"
             xmlns:components="clr-namespace:NteOmikuji.App.Components"
             x:Class="NteOmikuji.App.MainPage">

    <local:EmbeddedBlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <local:EmbeddedBlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </local:EmbeddedBlazorWebView.RootComponents>
    </local:EmbeddedBlazorWebView>

</ContentPage>
